@startuml
title Architecture Block Diagram

skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 80
skinparam componentStyle rectangle

package "User Interface (UI) Layer" {
  [NavigationHistoryDebugScreen]
  [NavigationOverlay]
  [DirectionsList]
  [NavigationScreen]
  [MapWidget]
  [SearchInput]
}

package "Business Logic (Services) Layer" {
  [NavigationHistoryService]
  [NavigationMonitor]
  [NavigationSessionService]
  [SearchHistoryService]
  [GeoUtils]
}

package "External Services / APIs Layer" {
  [DirectionsService]
  [PlacesService]
  [RoadsService]
}

package "Sensors & Persistence Layer" {
  [Geolocator Platform]
  [Compass Platform]
  [Local Storage]
}

' Intra-package UI relationships
[NavigationScreen] -r-> [MapWidget] : "Controls map"
[NavigationScreen] -l-> [SearchInput] : "Search UI"
[NavigationScreen] -u-> [DirectionsList] : "Shows steps"
[NavigationScreen] -u-> [NavigationOverlay] : "Alerts"

' UI to Logic
[NavigationScreen] --> [NavigationMonitor] : "Listens state"
[NavigationScreen] --> [NavigationHistoryService] : "Back-Stack"
[SearchInput] --> [SearchHistoryService] : "History"
[NavigationHistoryDebugScreen] --> [NavigationSessionService] : "Reads history"

' Logic to APIs
[NavigationMonitor] --> [RoadsService] : "Laterals"
[NavigationMonitor] --> [DirectionsService] : "Off-route"
[NavigationMonitor] -r-> [NavigationSessionService] : "Logs metrics"
[SearchInput] --> [PlacesService] : "Places API"

' Sensors to UI (Pointing up so Sensors stay below)
[Geolocator Platform] .u.> [NavigationScreen] : "GPS Stream"
[Compass Platform] .u.> [NavigationScreen] : "Heading Stream"

' Logic to Persistence
[NavigationSessionService] --> [Local Storage] : "Persists data"
[SearchHistoryService] --> [Local Storage] : "Persists data"

@enduml
