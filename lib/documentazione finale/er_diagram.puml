@startuml
title Entity-Relationship Diagram

entity "SearchHistoryItem" as SearchHistoryItem {
  * address : string <<PK>>
  --
  * lat : double
  * lng : double
  * timestamp_ms : int
}

entity "PlaceSuggestion" as PlaceSuggestion {
  * placeId : string <<PK>>
  --
  * description : string
}

entity "PlaceDetails" as PlaceDetails {
  * lat : double
  * lng : double
  * name : string
  * formattedAddress : string
}

entity "DirectionStep" as DirectionStep {
  * index : int <<PK>>
  --
  * instruction : string
  * distance : string
  * duration : string
  * startLat : double
  * startLng : double
  * endLat : double
  * endLng : double
  * maneuver : string
  * encodedStepPolyline : string
}

entity "RouteData" as RouteData {
  * encodedPolyline : string <<PK>>
  --
  * durationSeconds : int
  * totalDuration : string
  * totalDistance : string
}

entity "AllRoutesResult" as AllRoutesResult {
  * originLat : double
  * originLng : double
  * destLat : double
  * destLng : double
}

entity "NavigationMonitorState" as NavigationMonitorState {
  * isNavigating : bool
  * hasArrived : bool
  * isRerouting : bool
  * currentLat : double
  * currentLng : double
  * currentSpeed : double
  * rawBearing : double
  * compassHeading : double
  * currentAccuracy : double
  * currentStepIndex : int
  * consecutiveArrivalUpdates : int
  * consecutiveOffRouteDetects : int
  * navigationStartTime : datetime
}

entity "NavigationSession" as NavigationSession {
  * sessionId : string <<PK>>
  --
  * destination : string
  * startTime : string
  * endTime : string
  * rerouteCount : int
  * destinationReached : bool
  * extraData : map
}

entity "OverlayRecord" as OverlayRecord {
  * timestamp : string <<PK>>
  --
  * type : string
  * message : string
}

entity "NavigationOverlayState" as NavigationOverlayState {
  * type : string
  * message : string
  * maneuver : string
}

entity "RerouteState" as RerouteState {
  * phase : string
  * animStep : int
}

entity "ArrivalState" as ArrivalState {
  * isArrived : bool
  * animStep : int
  * isReviewingWalkedPath : bool
}

entity "WalkedPath" as WalkedPath {
  * lat : double
  * lng : double
  * sequenceIndex : int
}

entity "UIState" as UIState {
  * appState : string
  * isFollowingUser : bool
  * isLoading : bool
  * errorMessage : string
}

entity "SnappedPoint" as SnappedPoint {
  * placeId : string <<PK>>
  --
  * latitude : double
  * longitude : double
  * originalIndex : int
}

entity "NavigationHistoryEntry" as NavigationHistoryEntry {
  * state : string <<PK>>
  --
  * address : string
  * stackIndex : int
}

AllRoutesResult ||--|{ RouteData : "bestRoute + allRoutes"
RouteData ||--|{ DirectionStep : "composed of"
NavigationMonitorState ||--|| RouteData : "activeRoute"
NavigationMonitorState ||--o| RouteData : "previousRoute"
NavigationMonitorState ||--o{ RouteData : "alternativeRoutes"
NavigationMonitorState ||--o{ DirectionStep : "routeSteps"
NavigationMonitorState ||--o{ WalkedPath : "tracks"
NavigationMonitorState ||--o| NavigationOverlayState : "emits"
NavigationMonitorState ||--|| RerouteState : "reroutePhase"
NavigationMonitorState ||--|| ArrivalState : "arrivalState"
NavigationMonitorState ||--|| UIState : "drives"
UIState ||--o{ NavigationHistoryEntry : "backStack"
PlaceSuggestion ||--|| PlaceDetails : "resolves to"
PlaceDetails ||--o| AllRoutesResult : "destination for"
SearchHistoryItem ||--o| AllRoutesResult : "quick-launch to"
SnappedPoint }o--|| NavigationMonitorState : "lateral road analysis"
NavigationSession ||--o{ OverlayRecord : "contains"
NavigationMonitorState ||--o| NavigationSession : "tracked by"

@enduml
